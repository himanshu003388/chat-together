---
import Layout from '../../layouts/Layout.astro';

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;

const { data: profile } = await supabase
  .from('profiles')
  .select('*')
  .eq('id', user?.id)
  .maybeSingle();

---

<Layout title="Profile">
	<div class="max-w-2xl mx-auto py-8 sm:py-12 px-4 sm:px-6">
		<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 sm:gap-6 mb-6 sm:mb-10">
			<div>
				<p class="text-xs sm:text-sm text-white/40 font-mono mb-1 sm:mb-2">Your Profile</p>
				<h1 class="text-3xl sm:text-4xl font-bold">Account Settings</h1>
			</div>
			<a href="/profile/edit" class="btn-secondary text-sm w-full sm:w-auto text-center">
				Edit Profile
			</a>
		</div>

		<div class="glass-card p-6 sm:p-8">
			<div class="flex flex-col items-center mb-6 sm:mb-8">
				{profile?.avatar_url ? (
					<img src={`${import.meta.env.PUBLIC_SUPABASE_URL}/storage/v1/object/public/avatars/${profile.avatar_url}`} alt="" class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl object-cover border-2 border-accent-cyan/30 mb-3 sm:mb-4" />
				) : (
					<div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-gradient-to-br from-accent-cyan to-accent-purple flex items-center justify-center text-2xl sm:text-3xl font-bold mb-3 sm:mb-4 shadow-glow-cyan">
						{profile?.username?.charAt(0).toUpperCase()}
					</div>
				)}
				<h2 class="text-xl sm:text-2xl font-bold">{profile?.username}</h2>
				<span class="text-white/50 text-xs sm:text-sm font-mono break-all text-center">{profile?.email}</span>
			</div>

			<div class="space-y-4 sm:space-y-6">
				<div class="flex justify-between items-center py-3 sm:py-4 border-b border-white/10 gap-4">
					<span class="text-white/40 text-sm sm:text-base">Username</span>
					<span class="font-medium text-sm sm:text-base truncate max-w-[50%]">{profile?.username}</span>
				</div>

				<div class="flex justify-between items-center py-3 sm:py-4 border-b border-white/10 gap-4">
					<span class="text-white/40 text-sm sm:text-base">Bio</span>
					<span class="font-medium text-white/70 text-sm sm:text-base text-right truncate max-w-[60%]">{profile?.bio || 'No bio set'}</span>
				</div>

				<div class="flex justify-between items-center py-3 sm:py-4 border-b border-white/10 gap-4">
					<span class="text-white/40 text-sm sm:text-base">Role</span>
					<span class={`px-2 sm:px-3 py-1 rounded-full text-xs sm:text-sm font-medium ${profile?.role === 'admin' ? 'bg-accent-cyan/20 text-accent-cyan' : 'bg-white/10 text-white/70'}`}>
						{profile?.role}
					</span>
				</div>
			</div>

			<div class="mt-8 sm:mt-12 pt-6 sm:pt-8 border-t border-white/5">
				<form action="/api/auth/signout" method="post">
					<button type="submit" class="w-full btn-ghost border-red-500/20 text-red-400 hover:bg-red-500/10 transition-all flex items-center justify-center gap-3 py-3 sm:py-4 text-sm sm:text-base">
						<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
						</svg>
						Sign Out from Session
					</button>
				</form>
			</div>
		</div>
	</div>
</Layout>