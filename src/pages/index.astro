---
import Layout from '../layouts/Layout.astro';
import GeneralChat from '../components/GeneralChat';

const user = Astro.locals.user;
const profile = Astro.locals.profile;

const error = Astro.url.searchParams.get('error');
---

<Layout title="ChatTogether">
  {user ? (
    <div class="h-[calc(100vh-64px)] flex flex-col bg-surface-primary/20 relative">
      <div class="flex-1 overflow-hidden relative z-10">
        <GeneralChat
          client:load
          currentUser={{
            id: user.id,
            email: user.email || '',
            username: profile?.username
          }}
        />
      </div>
    </div>
  ) : (
    <div class="min-h-screen bg-surface-primary flex flex-col relative overflow-hidden">
      {/* Ambient background effects */}
      <div class="fixed inset-0 pointer-events-none overflow-hidden">
        <div class="absolute -top-40 -left-40 w-[500px] h-[500px] bg-accent-cyan/10 rounded-full blur-[120px]" />
        <div class="absolute -bottom-40 -right-40 w-[600px] h-[600px] bg-accent-purple/8 rounded-full blur-[120px]" />
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-accent-blue/5 rounded-full blur-[150px]" />
      </div>

      {/* Grid pattern overlay */}
      <div class="fixed inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;" />

      <div class="max-w-7xl mx-auto px-4 sm:px-8 pt-20 sm:pt-28 pb-16 relative z-10 flex-1 flex flex-col">
        {error && (
          <div class="max-w-md mx-auto mb-12 glass-card border-red-500/30 p-6 animate-in">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-red-500/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-bold text-red-400 uppercase tracking-tighter">System Alert</p>
                <p class="text-xs text-white/60 font-mono">{error}</p>
              </div>
            </div>
          </div>
        )}

        {/* Hero Section */}
        <div class="max-w-5xl mx-auto text-center pt-10 sm:pt-16 pb-16">
          <div class="inline-flex items-center gap-3 glass-dark border-accent-cyan/20 px-5 py-2.5 rounded-full mb-8 hover:border-accent-cyan/50 transition-colors animate-in">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-cyan opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-accent-cyan"></span>
            </span>
            <span class="text-[10px] font-bold text-white/70 uppercase tracking-[0.3em]">Real-time. Encrypted. Instant.</span>
          </div>

          <h1 class="text-[2.5rem] sm:text-6xl md:text-7xl lg:text-8xl font-black mb-6 leading-[0.9] tracking-tighter uppercase italic animate-in stagger-1">
            <span class="text-white">Connect</span><br/>
            <span class="bg-gradient-to-r from-accent-cyan via-accent-blue to-accent-purple bg-clip-text text-transparent drop-shadow-[0_0_40px_rgba(0,212,255,0.3)]"> Instantly.</span>
          </h1>

          <p class="text-base sm:text-lg md:text-xl text-white/50 max-w-3xl mx-auto mb-8 sm:mb-12 leading-relaxed font-medium animate-in stagger-2 px-4">
            Experience real-time messaging that actually feels real-time. No polling, no delays — just instant delivery, end-to-end encrypted, at any scale.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center items-center mb-16 sm:mb-20 animate-in stagger-3 px-4">
            <a href="/signup" class="group relative inline-flex items-center gap-2 sm:gap-3 px-6 sm:px-10 py-4 sm:py-5 rounded-2xl bg-gradient-to-r from-accent-cyan to-accent-blue text-surface-primary font-bold text-sm sm:text-base tracking-wider uppercase shadow-2xl shadow-accent-cyan/20 hover:shadow-accent-cyan/40 hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 w-full sm:w-auto justify-center">
              <span>Get Started Free</span>
              <svg class="w-4 h-4 sm:w-5 sm:h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
            <a href="/login" class="px-6 sm:px-10 py-4 sm:py-5 rounded-2xl border border-white/10 text-white/50 hover:text-white hover:bg-white/[0.03] hover:border-white/20 transition-all text-sm font-bold tracking-widest uppercase w-full sm:w-auto text-center">
              Sign In
            </a>
          </div>
        </div>

        {/* Features Grid */}
        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6 mt-auto animate-in stagger-4 px-4 sm:px-0">
          <div class="group glass-card border-white/[0.04] hover:border-accent-cyan/30 transition-all duration-500 p-6 sm:p-8 relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-accent-cyan/0 via-accent-cyan/0 to-accent-cyan/[0.02] group-hover:via-accent-cyan/[0.02] group-hover:to-accent-cyan/[0.05] transition-all duration-700" />
            <div class="relative z-10">
              <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-br from-accent-cyan/20 to-accent-cyan/5 border border-accent-cyan/10 flex items-center justify-center mb-4 sm:mb-6 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 shadow-lg shadow-accent-cyan/5">
                <svg class="w-6 h-6 sm:w-7 sm:h-7 text-accent-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold mb-2 sm:mb-3 tracking-tight uppercase italic">Sub-100ms Delivery</h3>
              <p class="text-white/40 text-xs sm:text-sm leading-relaxed font-mono">
                Powered by WebSocket clusters with automatic failover. Messages arrive before you finish typing.
              </p>
            </div>
          </div>

          <div class="group glass-card border-white/[0.04] hover:border-accent-purple/30 transition-all duration-500 p-6 sm:p-8 relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-accent-purple/0 via-accent-purple/0 to-accent-purple/[0.02] group-hover:via-accent-purple/[0.02] group-hover:to-accent-purple/[0.05] transition-all duration-700" />
            <div class="relative z-10">
              <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-br from-accent-purple/20 to-accent-purple/5 border border-accent-purple/10 flex items-center justify-center mb-4 sm:mb-6 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 shadow-lg shadow-accent-purple/5">
                <svg class="w-6 h-6 sm:w-7 sm:h-7 text-accent-purple" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold mb-2 sm:mb-3 tracking-tight uppercase italic">Zero-Knowledge Encryption</h3>
              <p class="text-white/40 text-xs sm:text-sm leading-relaxed font-mono">
                AES-256 encrypted at rest, TLS 1.3 in transit. Your conversations are yours alone.
              </p>
            </div>
          </div>

          <div class="group glass-card border-white/[0.04] hover:border-accent-pink/30 transition-all duration-500 p-6 sm:p-8 relative overflow-hidden sm:col-span-2 md:col-span-1">
            <div class="absolute inset-0 bg-gradient-to-br from-accent-pink/0 via-accent-pink/0 to-accent-pink/[0.02] group-hover:via-accent-pink/[0.02] group-hover:to-accent-pink/[0.05] transition-all duration-700" />
            <div class="relative z-10">
              <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-br from-accent-pink/20 to-accent-pink/5 border border-accent-pink/10 flex items-center justify-center mb-4 sm:mb-6 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 shadow-lg shadow-accent-pink/5">
                <svg class="w-6 h-6 sm:w-7 sm:h-7 text-accent-pink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0" />
                </svg>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold mb-2 sm:mb-3 tracking-tight uppercase italic">Unlimited Scalability</h3>
              <p class="text-white/40 text-xs sm:text-sm leading-relaxed font-mono">
                Distributed architecture handling millions of concurrent connections across global edge nodes.
              </p>
            </div>
          </div>
        </div>
      </div>

      <footer class="border-t border-white/[0.03] relative z-10 bg-black/30">
        <div class="max-w-7xl mx-auto px-4 sm:px-8 py-6 sm:py-8 flex flex-col sm:flex-row justify-between items-center gap-4 sm:gap-6">
          <div class="flex items-center gap-3">
            <div class="w-2 h-2 rounded-full bg-accent-cyan shadow-[0_0_8px_rgba(0,212,255,0.6)]" />
            <p class="text-[10px] sm:text-xs font-mono text-white/20 tracking-widest uppercase">ChatTogether v1.0</p>
          </div>
          <div class="flex gap-6 sm:gap-8">
            <a href="#" class="text-[10px] font-bold text-white/20 hover:text-accent-cyan transition-colors tracking-widest uppercase">Privacy</a>
            <a href="#" class="text-[10px] font-bold text-white/20 hover:text-accent-cyan transition-colors tracking-widest uppercase">Terms</a>
            <a href="#" class="text-[10px] font-bold text-white/20 hover:text-accent-cyan transition-colors tracking-widest uppercase">Status</a>
          </div>
        </div>
      </footer>
    </div>
  )}
</Layout>
