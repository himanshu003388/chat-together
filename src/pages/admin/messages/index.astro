---
import Layout from '../../../layouts/Layout.astro';
import { AdminService } from '../../../services/admin.service';
import { createAdminClient } from '../../../lib/supabase';
import { logger } from '../../../utils/logger';
import { ChevronLeft, MessageCircle, Trash2 } from 'lucide-react';

const profile = Astro.locals.profile;

if (profile?.role !== 'admin') {
  return Astro.redirect('/');
}

const adminClient = createAdminClient();
const adminService = new AdminService(Astro.locals.supabase, adminClient);
let successMessage = '';

// Handle delete message with redirect-after-POST
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const messageId = formData.get('messageId')?.toString();
    const action = formData.get('action')?.toString();

    if (messageId && action === 'delete') {
      await adminService.deleteMessage(messageId);
      return Astro.redirect('/admin/messages?success=Message+deleted');
    }
  } catch (err: any) {
    logger.error(err, 'Admin action failed');
    return Astro.redirect(`/admin/messages?error=${encodeURIComponent(err.message)}`);
  }
}

const allMessages = await adminService.getAllMessages(100);
const url = new URL(Astro.request.url);
successMessage = url.searchParams.get('success') || '';
const errorMessage = url.searchParams.get('error') || '';
---

<Layout title="Message Logs">
  <div class="min-h-screen bg-surface-primary p-4 sm:p-8">
    {/* Header */}
    <div class="flex items-center gap-3 sm:gap-4 mb-6 sm:mb-10">
      <a href="/admin" class="p-2 sm:p-3 hover:bg-white/5 rounded-xl transition-colors">
        <ChevronLeft className="w-5 h-5 sm:w-6 sm:h-6 text-white/40" />
      </a>
      <div>
        <div class="flex items-center gap-2 sm:gap-3 mb-1 sm:mb-2">
          <MessageCircle className="w-4 h-4 sm:w-5 sm:h-5 text-accent-purple animate-pulse" />
          <span class="text-[8px] sm:text-[10px] font-bold text-accent-purple uppercase tracking-[0.3em]">Data Oversight</span>
        </div>
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black tracking-tighter uppercase italic">Transmission Logs</h1>
      </div>
    </div>

    {errorMessage && (
      <div class="glass-dark border-accent-pink/30 bg-accent-pink/10 p-4 rounded-2xl mb-6 flex items-center gap-3">
        <span class="text-accent-pink text-sm font-bold uppercase">{errorMessage}</span>
      </div>
    )}

    {successMessage && (
      <div class="glass-dark border-accent-emerald/30 bg-accent-emerald/10 p-4 rounded-2xl mb-6 flex items-center gap-3">
        <span class="text-accent-emerald text-sm font-bold uppercase">{successMessage}</span>
      </div>
    )}

    <div class="glass-dark border border-white/10 rounded-2xl overflow-hidden">
      <div class="p-4 border-b border-white/5 bg-white/[0.02] flex justify-between items-center">
        <span class="text-[10px] font-bold text-white/40 uppercase tracking-widest">
          {allMessages?.length || 0} Total Transmissions
        </span>
      </div>

      <div class="divide-y divide-white/5 max-h-[70vh] overflow-y-auto">
        {allMessages?.map((m) => (
          <div class="p-3 sm:p-4 hover:bg-white/[0.02] transition-colors">
            <div class="flex items-start justify-between gap-3 sm:gap-4">
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-1.5 sm:mb-2">
                  <div class="w-6 h-6 sm:w-8 sm:h-8 rounded-lg bg-gradient-to-br from-accent-cyan to-accent-blue flex items-center justify-center font-bold text-surface-primary text-[10px] sm:text-xs shrink-0">
                    {m.profiles?.username?.[0].toUpperCase()}
                  </div>
                  <span class="font-bold text-xs sm:text-sm text-accent-cyan truncate">{m.profiles?.username || 'Unknown'}</span>
                  {m.chat_rooms && (
                    <span class="text-[8px] sm:text-[10px] text-white/40 bg-white/5 px-1.5 sm:px-2 py-0.5 rounded-full">
                      #{m.chat_rooms.name}
                    </span>
                  )}
                  {!m.chat_id && !m.receiver_id && (
                    <span class="text-[8px] sm:text-[10px] text-accent-purple bg-accent-purple/10 px-1.5 sm:px-2 py-0.5 rounded-full">
                      General
                    </span>
                  )}
                  {m.receiver_id && (
                    <span class="text-[8px] sm:text-[10px] text-accent-pink bg-accent-pink/10 px-1.5 sm:px-2 py-0.5 rounded-full">
                      Private
                    </span>
                  )}
                  <span class="text-[8px] sm:text-[10px] text-white/30 font-mono hidden sm:inline">
                    {new Date(m.created_at).toLocaleString()}
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-white/70 line-clamp-2 sm:line-clamp-none">{m.content || '[File Attachment]'}</p>
                  {m.file_url && (
                    <div class="mt-1 sm:mt-2 text-[8px] sm:text-[10px] text-white/40 font-mono truncate">
                      {m.file_name || 'Attachment'}
                    </div>
                  )}
                <span class="text-[8px] text-white/20 font-mono sm:hidden mt-1 block">
                  {new Date(m.created_at).toLocaleString()}
                </span>
              </div>
              <form method="post" class="shrink-0">
                <input type="hidden" name="messageId" value={m.id} />
                <button
                  type="submit"
                  name="action"
                  value="delete"
                  class="p-1.5 sm:p-2 rounded-lg sm:rounded-xl bg-red-500/10 text-red-400 hover:bg-red-500/20 transition-all"
                  onclick="return confirm('Delete this message?')"
                >
                  <Trash2 className="w-3.5 h-3.5 sm:w-4 sm:h-4" />
                </button>
              </form>
            </div>
          </div>
        ))}

        {(!allMessages || allMessages.length === 0) && (
          <div class="p-8 sm:p-12 text-center">
            <MessageCircle className="w-8 h-8 sm:w-12 sm:h-12 text-white/20 mx-auto mb-3 sm:mb-4" />
            <p class="text-white/40 text-xs sm:text-sm">No transmissions found</p>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>